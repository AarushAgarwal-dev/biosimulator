# BioSimulateAI - server configuration (TEMPLATE)
# ----------------------------------------------------------------------------
# Copy this file to ".env" (same folder), fill in what you use, then restart the
# server. The app reads .env at startup; no key is ever typed into or sent to the UI.
#
#   cp .env.example .env      # then edit .env
#
# SECURITY: .env holds secrets. Do NOT commit it (.gitignore excludes it).
# ----------------------------------------------------------------------------

# --- AI engine the UI selects by default: purdue | bedrock | off ---
LLM_ENGINE=purdue

# --- Purdue GenAI Studio (recommended) ---
# Create a key in GenAI Studio: avatar > Settings > Account > API Keys.
# The key acts with YOUR GenAI Studio identity (60 requests/minute per user).
PURDUE_GENAI_API_KEY=PASTE_YOUR_GENAI_STUDIO_KEY_HERE
PURDUE_GENAI_BASE_URL=https://genai.rcac.purdue.edu/api
# gpt-oss:120b answers a model-compilation request in ~10-30 s; list others with GET /api/models.
PURDUE_GENAI_MODEL=gpt-oss:120b
# Vision models tried in order for photos of equations.
PURDUE_GENAI_VISION_MODELS=gemma4:26b-a4b,qwen3-vl:32b,llava:latest

# Who may use the Purdue engine when BIOSIM_REQUIRE_PAID_ACCESS_TOKEN is set (public deploys):
#   0 = only callers with the deployment token; everyone else gets the rule-based compiler
#   1 = anyone, rate-limited (only if GenAI Studio's terms allow you to serve anonymous users)
BIOSIM_PURDUE_PUBLIC=0
BIOSIM_LLM_RATE_PER_MIN=8
BIOSIM_LLM_GLOBAL_RATE_PER_MIN=15

# --- Deployment access token (public deployments) ---
# BIOSIM_REQUIRE_PAID_ACCESS_TOKEN=1
# BIOSIM_PAID_ACCESS_TOKEN=GENERATE_A_RANDOM_32_PLUS_CHARACTER_VALUE

# --- OPTIONAL: AWS Bedrock (legacy engine) ---
# AWS_BEARER_TOKEN_BEDROCK=PASTE_YOUR_BEDROCK_API_KEY_HERE
# AWS_DEFAULT_REGION=us-east-2
# BEDROCK_REGION=us-east-2
# BEDROCK_MODEL_ID=mistral.mistral-large-3-675b-instruct
