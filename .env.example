# BioSimulateAI - AWS Bedrock configuration (TEMPLATE)
# ----------------------------------------------------------------------------
# Copy this file to ".env" (same folder), fill in ONE credential option, then
# restart the server. The app reads .env at startup and calls Bedrock with it,
# so you never type a key into the app UI.
#
#   cp .env.example .env      # then edit .env
#
# SECURITY: .env holds secrets. Do NOT commit it (.gitignore excludes it).
# ----------------------------------------------------------------------------

# --- OPTION A (recommended): Bedrock API key (bearer token) ---
AWS_BEARER_TOKEN_BEDROCK=PASTE_YOUR_BEDROCK_API_KEY_HERE

# --- OPTION B: static IAM access keys (use INSTEAD of Option A) ---
# AWS_ACCESS_KEY_ID=PASTE_YOUR_ACCESS_KEY_ID_HERE
# AWS_SECRET_ACCESS_KEY=PASTE_YOUR_SECRET_ACCESS_KEY_HERE
# AWS_SESSION_TOKEN=PASTE_YOUR_SESSION_TOKEN_HERE   # only for temporary creds

# --- Bedrock model + region ---
AWS_DEFAULT_REGION=us-east-2
BEDROCK_REGION=us-east-2
BEDROCK_MODEL_ID=mistral.mistral-large-3-675b-instruct

# --- Make the app default to the Bedrock engine on load ---
LLM_ENGINE=bedrock
